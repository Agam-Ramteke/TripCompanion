<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext is off everywhere, no exceptions.

    Every host the app talks to serves HTTPS: RailRadar (api.railradar.in) is TLS-only by
    policy, and Nominatim search and the OpenStreetMap tile fetches are HTTPS too. The one
    cleartext exception this file used to carry was for indianrailapi.com, the live-status
    vendor that has since been replaced by RailRadar — with it gone, the whole app is TLS-only
    and a plaintext request is a bug rather than a fallback.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
